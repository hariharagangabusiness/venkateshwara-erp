# Copy this file to .env and fill in what you need. All values are optional -
# the app runs end-to-end with none of these set.

# JWT signing secret (change this in production)
JWT_SECRET=

# SMTP email (Round 5) - fallback/default when Company Settings > Email
# Settings in the app has nothing saved for a field. DB settings, once saved,
# override these. If neither is configured, automated emails (PO to vendor,
# etc.) are skipped gracefully with a clear "not configured" message.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM_NAME=Venkateshwara Engineers
SMTP_FROM_ADDRESS=
# Comma-separated list of addresses always CC'd on automated emails
SMTP_DEFAULT_CC=

# Optional: path to a Chrome/Edge/Chromium executable, used for PDF generation
# (challans, purchase orders, invoices). If unset, the app looks for a
# system-installed browser automatically.
PDF_CHROME_PATH=

# Daily backups (DB snapshot + uploaded files) - see Admin > Backups.
# BACKUP_DIR: where backups are written. Defaults to a "backups" folder next
#   to erp.db (i.e. under DATA_DIR if set) - point this at a SEPARATE volume
#   if you want backups to survive the loss of the main data volume.
BACKUP_DIR=
# How many days of backups to keep before old ones are deleted (log entries
# in Admin > Backups are kept regardless).
BACKUP_RETENTION_DAYS=14
# Optional: email each day's backup here as an offsite copy (only when it's
# under ~20MB and SMTP is configured above). Leave unset to keep backups
# local-only.
BACKUP_EMAIL_TO=
